@model IEnumerable<GameStore.Models.Order>

@{
    ViewData["Title"] = "Orders Report";
}

<div class="bg-light rounded h-100 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h6 class="mb-0">Sipariş ve Satış Raporu</h6>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Sipariş ID</th>
                    <th scope="col">Tarih</th>
                    <th scope="col">Kullanıcı</th>
                    <th scope="col">Toplam Tutar</th>
                    <th scope="col">Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@item.AppUser?.UserName</td>
                    <td>@item.TotalAmount.ToString("N2") ₺</td>
                    <td>@item.Status</td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
