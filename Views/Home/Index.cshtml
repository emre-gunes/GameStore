@model IEnumerable<GameStore.Models.Game>
@{
    ViewData["Title"] = "Home Page";
}

<div class="main-banner">
  <div class="container">
    <div class="row">
      <div class="col-lg-6 align-self-center">
        <div class="caption header-text">
          <h6>GameStore'a Hoşgeldiniz</h6>
          <h2>EN İYİ OYUN PLATFORMU!</h2>
          <p>Tüm oyun ihtiyaçlarınız için dijital mağazanız. Oyun alın, oynayın ve tadını çıkarın!</p>
          <div class="search-input">
            <form id="search" action="/Home/Shop">
              <input type="text" placeholder="Bir Şeyler Yazın" id='searchText' name="searchKeyword" onkeypress="handle" />
              <button role="button">Şimdi Ara</button>
            </form>
          </div>
        </div>
      </div>
      <div class="col-lg-4 offset-lg-2">
        <div class="right-image">
          <img src="~/assets/images/banner-image.jpg" alt="">
          <span class="price">1250 ₺</span>
          <span class="offer">-40%</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="features">
  <div class="container">
    <div class="row">
      <div class="col-lg-3 col-md-6">
        <a href="#">
          <div class="item">
            <div class="image">
              <img src="~/assets/images/featured-01.png" alt="" style="max-width: 44px;">
            </div>
            <h4>Free Storage</h4>
          </div>
        </a>
      </div>
      <div class="col-lg-3 col-md-6">
        <a href="#">
          <div class="item">
            <div class="image">
              <img src="~/assets/images/featured-02.png" alt="" style="max-width: 44px;">
            </div>
            <h4>User More</h4>
          </div>
        </a>
      </div>
      <div class="col-lg-3 col-md-6">
        <a href="#">
          <div class="item">
            <div class="image">
              <img src="~/assets/images/featured-03.png" alt="" style="max-width: 44px;">
            </div>
            <h4>Reply Ready</h4>
          </div>
        </a>
      </div>
      <div class="col-lg-3 col-md-6">
        <a href="#">
          <div class="item">
            <div class="image">
              <img src="~/assets/images/featured-04.png" alt="" style="max-width: 44px;">
            </div>
            <h4>Easy Layout</h4>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="section trending">
  <div class="container">
    <div class="row">
      <div class="col-lg-6">
        <div class="section-heading">
          <h6>Popüler</h6>
          <h2>Popüler Oyunlar</h2>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="main-button">
          <a asp-action="Shop">Tümünü Gör</a>
        </div>
      </div>
      @foreach(var item in Model) {
        <div class="col-lg-3 col-md-6">
          <div class="item">
            <div class="thumb">
              <a asp-action="ProductDetails" asp-route-id="@item.Id">
                <img src="@item.ImageUrl" alt="">
              </a>
              <span class="price">@item.Price ₺</span>
            </div>
            <div class="down-content">
              <span class="category">@item.Category?.Name</span>
              <h4>@item.Title</h4>
              <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id"><i class="fa fa-shopping-bag"></i></a>
            </div>
          </div>
        </div>
      }
    </div>
  </div>
</div>

<div class="section cta">
  <div class="container">
    <div class="row">
      <div class="col-lg-5">
        <div class="shop">
          <div class="row">
            <div class="col-lg-12">
              <div class="section-heading">
                <h6>Our Shop</h6>
                <h2>Go Pre-Order Buy & Get Best <em>Prices</em> For You!</h2>
              </div>
              <p>Find the best games with the best deals.</p>
              <div class="main-button">
                <a asp-action="Shop">Shop Now</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
