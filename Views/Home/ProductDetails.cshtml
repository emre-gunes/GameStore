@model GameStore.Models.Game

@{
    ViewData["Title"] = "Product Details";
}

<div class="page-heading header-text">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <h3>@Model.Title</h3>
        <span class="breadcrumb"><a asp-action="Index">Ana Sayfa</a> > <a asp-action="Shop">Mağaza</a> > @Model.Title</span>
      </div>
    </div>
  </div>
</div>

<div class="single-product section">
  <div class="container">
    <div class="row">
      <div class="col-lg-6">
        <div class="left-image">
          <img src="@Model.ImageUrl" alt="">
        </div>
      </div>
      <div class="col-lg-6 align-self-center">
        <h4>@Model.Title</h4>
        <span class="price">@Model.Price ₺</span>
        <p>@Model.Description</p>
        <form id="qty" action="/Cart/Add/@Model.Id">
          <button type="submit"><i class="fa fa-shopping-bag"></i> SEPETE EKLE</button>
        </form>
        <ul>
          <li><span>Kategori:</span> @Model.Category?.Name</li>
          <li><span>Stok:</span> @Model.StockQuantity</li>
        </ul>
      </div>
      <div class="col-lg-12">
        <div class="sep"></div>
      </div>
    </div>
  </div>
</div>
