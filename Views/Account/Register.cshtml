@{
    ViewData["Title"] = "Register";
}

<div class="page-heading header-text">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <h3>Hesap Oluştur</h3>
        <span class="breadcrumb"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a> > Kayıt Ol</span>
      </div>
    </div>
  </div>
</div>

<div class="contact-page section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="right-content">
          <div class="row">
            <div class="col-lg-12">
                <form id="contact-form" asp-action="Register" method="post" style="background-color: #2a2a2a; padding: 40px; border-radius: 20px;">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="text-danger"></div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-lg-12">
                            <fieldset>
                                <input type="email" name="email" id="email" placeholder="E-posta Adresi" autocomplete="on" required style="width: 100%; height: 50px; border-radius: 25px; background-color: #f4f5f8; border: none; padding: 0px 25px; margin-bottom: 30px; font-size: 14px; font-weight: 400; color: #4a4a4a;">
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <input type="password" name="password" id="password" placeholder="Şifre" required style="width: 100%; height: 50px; border-radius: 25px; background-color: #f4f5f8; border: none; padding: 0px 25px; margin-bottom: 30px; font-size: 14px; font-weight: 400; color: #4a4a4a;">
                            </fieldset>
                        </div>
                        <div class="col-lg-12 text-center">
                            <fieldset>
                                <button type="submit" id="form-submit" style="display: inline-block; background-color: #ee626b; color: #fff; font-size: 14px; text-transform: uppercase; font-weight: 500; padding: 12px 30px; border-radius: 25px; border: none; transition: all .3s; cursor:pointer;">Kayıt Ol</button>
                            </fieldset>
                        </div>
                    </div>
                </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
